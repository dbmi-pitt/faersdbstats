      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>props="${BASE_FILE_DIR}/data_new/vocab_wc.properties"; mkdir -p "$(dirname "$props")"; echo "DOMAIN_WC=$(wc -l ${OMOP_FILE_DIR}/DOMAIN.csv | awk '{print $1}')" > "$props"; echo "VOCABULARY_WC=$(wc -l ${OMOP_FILE_DIR}/VOCABULARY.csv | awk '{print $1}')" >> "$props"; echo "CONCEPT_CLASS_WC=$(wc -l ${OMOP_FILE_DIR}/CONCEPT_CLASS.csv | awk '{print $1}')" >> "$props"; echo "RELATIONSHIP_WC=$(wc -l ${OMOP_FILE_DIR}/RELATIONSHIP.csv | awk '{print $1}')" >> "$props"; echo "DRUG_STRENGTH_WC=$(wc -l ${OMOP_FILE_DIR}/DRUG_STRENGTH.csv | awk '{print $1}')" >> "$props"; echo "CONCEPT_SYNONYM_WC=$(wc -l ${OMOP_FILE_DIR}/CONCEPT_SYNONYM.csv | awk '{print $1}')" >> "$props"; echo "CONCEPT_RELATIONSHIP_WC=$(wc -l ${OMOP_FILE_DIR}/CONCEPT_RELATIONSHIP.csv | awk '{print $1}')" >> "$props"; echo "CONCEPT_ANCESTOR_WC=$(wc -l ${OMOP_FILE_DIR}/CONCEPT_ANCESTOR.csv | awk '{print $1}')" >> "$props"; echo "CONCEPT_WC=$(wc -l ${OMOP_FILE_DIR}/CONCEPT.csv | awk '{print $1}')" >> "$props";</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>21</nr>
      <xloc>656</xloc>
      <yloc>16</yloc>
      <attributes_kjc/>
    </entry>
