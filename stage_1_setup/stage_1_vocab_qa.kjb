    <entry>
      <name>Create QA table</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE TABLE IF NOT EXISTS staging_vocabulary.z_qa_vocab_wc_import_log (
	log_filename varchar(255) NOT NULL,
	filename varchar(255) NOT NULL,
	wc_l_count int4 NOT NULL,
	loaded_at timestamp DEFAULT CURRENT_TIMESTAMP NULL,
	select_count_on_domain int4 NULL,
	select_count_diff int4 NULL,
	select_count_diff_pct float8 NULL
);</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>${DATABASE_NAME}</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>1</nr>
      <xloc>320</xloc>
      <yloc>160</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Insert domain QA</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO staging_vocabulary.z_qa_vocab_wc_import_log (log_filename, filename, wc_l_count, select_count_on_domain, select_count_diff, select_count_diff_pct)
VALUES ('${LOG_FILENAME}', 'DOMAIN.csv', 49, (SELECT COUNT(*) FROM staging_vocabulary.domain), 49 - (SELECT COUNT(*) FROM staging_vocabulary.domain) - 1, ((49 - (SELECT COUNT(*) FROM staging_vocabulary.domain) - 1)::float / 49) * 100);</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>${DATABASE_NAME}</connection>
