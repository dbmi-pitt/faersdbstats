    <add_date>N</add_date>
    <add_time>N</add_time>
    <insertScript>Y</insertScript>
    <script>CONFIG_PATH="${Internal.Transformation.Filename.Directory}/../../faers_config.config"
# Try to locate and call the helper script that validates and sources config files
CONFIG_HELPER="${Internal.Transformation.Filename.Directory}/../../stage_0_set_pentaho_vars/check_and_source_config.sh"
if [ -x "$CONFIG_HELPER" ]; then
  "$CONFIG_HELPER" "$CONFIG_PATH" "OMOP_FILE_DIR"
else
  # Fallback: source the config directly (backward compatibility)
  if [ -f "$CONFIG_PATH" ]; then
    . "$CONFIG_PATH"
  fi
fi
export PGPASSWORD="${DATABASE_PASSWORD}"
psql -h "${DATABASE_HOST}" -p "${DATABASE_PORT}" -U "${DATABASE_USERNAME}" -d "${DATABASE_NAME}" -c "truncate table staging_vocabulary.concept"
psql -h "${DATABASE_HOST}" -p "${DATABASE_PORT}" -U "${DATABASE_USERNAME}" -d "${DATABASE_NAME}" -c "\\COPY staging_vocabulary.concept FROM '${OMOP_FILE_DIR}/CONCEPT.csv' WITH (FORMAT csv, DELIMITER E'\t', HEADER true, QUOTE E'\b', ESCAPE E'\b')"
</script>
    <loglevel>Basic</loglevel>
